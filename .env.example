PREFIX=.
# Optional: enables .ai and .chatbot (free key from console.groq.com)
GROQ_API_KEY=

# Keep WhatsApp logins + settings in Neon Postgres (needed on hosts with no disk)
# Neon dashboard > Connect > copy the connection string. Keep it secret.
DATABASE_URL=
AUTH_PREFIX=stacy

# Pairing website: password people must enter to link a number. Leave empty to disable the page.
PAIR_PASSWORD=
MAX_SESSIONS=20

# Optional: pair one number from the logs instead of the website
PAIRING_NUMBER=
# Optional: only used if no database is set (e.g. a persistent disk path)
DATA_DIR=
