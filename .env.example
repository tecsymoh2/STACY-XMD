# Your WhatsApp number with country code, digits only (no +)
PAIRING_NUMBER=2547XXXXXXXX
OWNER_NUMBER=2547XXXXXXXX
PREFIX=.
# Optional: enables .ai and .chatbot (free key from console.groq.com)
GROQ_API_KEY=

# Optional: keep the WhatsApp login + settings in Neon Postgres (for hosts with no disk)
# Neon dashboard > Connect > copy the connection string. Keep it secret.
DATABASE_URL=
AUTH_PREFIX=stacy

# Optional: local storage folder (e.g. a persistent disk path) when not using a database
DATA_DIR=
